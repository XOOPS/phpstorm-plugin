<templateSet group="XOOPS">
    <template name="xoguard"
              value="defined('XOOPS_ROOT_PATH') || exit('Restricted access');"
              description="XOOPS direct-access guard"
              toReformat="false" toShortenFQNames="false">
        <context>
            <option name="PHP" value="true"/>
        </context>
    </template>

    <template name="xofetch"
              value="$$result = $$db-&gt;query($SQL$);&#10;if (!$$db-&gt;isResultSet($$result) || !$$result instanceof \mysqli_result) {&#10;    return null;&#10;}&#10;$$row = $$db-&gt;fetchArray($$result);"
              description="XOOPS guarded query + fetch"
              toReformat="true" toShortenFQNames="false">
        <variable name="SQL" expression="" defaultValue="" alwaysStopAt="true"/>
        <context>
            <option name="PHP" value="true"/>
        </context>
    </template>

    <template name="xolang"
              value="define('_MI_$NAME$', '$VALUE$');"
              description="XOOPS language constant"
              toReformat="false" toShortenFQNames="false">
        <variable name="NAME" expression="" defaultValue="" alwaysStopAt="true"/>
        <variable name="VALUE" expression="" defaultValue="" alwaysStopAt="true"/>
        <context>
            <option name="PHP" value="true"/>
        </context>
    </template>

    <template name="xocriteria"
              value="$$criteria = new \CriteriaCompo(new \Criteria('$FIELD$', $VALUE$));"
              description="XOOPS CriteriaCompo"
              toReformat="false" toShortenFQNames="false">
        <variable name="FIELD" expression="" defaultValue="" alwaysStopAt="true"/>
        <variable name="VALUE" expression="" defaultValue="" alwaysStopAt="true"/>
        <context>
            <option name="PHP" value="true"/>
        </context>
    </template>

    <template name="xorequest"
              value="$$value = \Xmf\Request::getString('$KEY$', '', 'POST');"
              description="Scoped Xmf\Request read"
              toReformat="false" toShortenFQNames="false">
        <variable name="KEY" expression="" defaultValue="" alwaysStopAt="true"/>
        <context>
            <option name="PHP" value="true"/>
        </context>
    </template>
    <template name="xofetchdb"
              value="$$result = $$db-&gt;query(&quot;$SQL$&quot;);&#10;$$row = null;&#10;if ($$db-&gt;isResultSet($$result) &amp;&amp; $$result instanceof \mysqli_result) {&#10;    $$row = $$db-&gt;fetchArray($$result);&#10;}$END$"
              description="query + isResultSet guard + fetchArray ($db), no early return"
              toReformat="true"
              toShortenFQNames="true">
        <variable name="SQL" expression="" defaultValue="&quot;SELECT 1&quot;" alwaysStopAt="true"/>
        <context>
            <option name="PHP" value="true"/>
        </context>
    </template>
    <template name="xohead"
              value="/**&#10; * $DESCRIPTION$&#10; *&#10; * @category  $CATEGORY$&#10; * @package   $PACKAGE$&#10; * @author    $AUTHOR$&#10; * @copyright $COPYRIGHT$&#10; * @license   GNU GPL 2.0 or later (https://www.gnu.org/licenses/gpl-2.0.html)&#10; * @link      https://xoops.org&#10; */$END$"
              description="XOOPS PHPDoc file header"
              toReformat="false"
              toShortenFQNames="true">
        <variable name="DESCRIPTION" expression="" defaultValue="&quot;XOOPS component&quot;" alwaysStopAt="true"/>
        <variable name="CATEGORY" expression="" defaultValue="&quot;XOOPS&quot;" alwaysStopAt="true"/>
        <variable name="PACKAGE" expression="" defaultValue="&quot;XOOPS&quot;" alwaysStopAt="true"/>
        <variable name="AUTHOR" expression="" defaultValue="&quot;XOOPS Project&quot;" alwaysStopAt="true"/>
        <variable name="COPYRIGHT" expression="" defaultValue="&quot;2000-2026 XOOPS Project (https://xoops.org)&quot;" alwaysStopAt="true"/>
        <context>
            <option name="PHP" value="true"/>
        </context>
    </template>
    <template name="xoexec"
              value="$$this-&gt;db-&gt;exec(&quot;$SQL$&quot;);$END$"
              description="Mutating SQL via exec()"
              toReformat="true"
              toShortenFQNames="true">
        <variable name="SQL" expression="" defaultValue="&quot;UPDATE ...&quot;" alwaysStopAt="true"/>
        <context>
            <option name="PHP" value="true"/>
        </context>
    </template>
</templateSet>
